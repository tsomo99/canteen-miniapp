.page {
  padding: 20rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  background: #fff;
  padding: 16rpx;
  border-radius: 8rpx;
}
.name {
  font-weight: bold;
}
.count, .price {
  color: #555;
}
.total {
  font-size: 30rpx;
  font-weight: bold;
  margin: 20rpx 0;
  text-align: right;
}
button {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
}
